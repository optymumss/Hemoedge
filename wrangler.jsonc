{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hemoedge",
  // main + assets: generated by `vinext init` — adapter-specific, keep as is.
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  // Non-secret config. Secrets (see docs/cloudflare-runbook.md) are set with
  // `wrangler secret put` or the dashboard, never committed. A deploy
  // replaces all plain vars with this list, so none are set in the dashboard.
  "vars": {
    "R2_BUCKET_NAME": "hemoedge-slides",
    "R2_PUBLIC_URL": "https://pub-880b5a4e70584eb18d3dab258861f957.r2.dev",
    "TILER_URL": "https://hemoedge-tiler.consultant-bdd.workers.dev"
  }
}
