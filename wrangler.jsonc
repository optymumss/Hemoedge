{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hemoedge",
  // main + assets: generated by `vinext init` — adapter-specific, keep as is.
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Non-secret config; values are filled in when the Worker is provisioned.
  // Secrets are set with `wrangler secret put`, never committed.
  "vars": {
    "EMAIL_FROM": "",
    "ENQUIRY_NOTIFY_EMAIL": "",
    "R2_BUCKET_NAME": "",
    "R2_PUBLIC_URL": "",
    "APP_URL": ""
  }
}
